# The Youth Matters: one settings file for the whole project (backend + website).
# .env is private (gitignored). .env.example is the shared template: copy it to .env.
# The website only ever sees variables that start with VITE_; everything else stays on the server.

# ---------------------------------------------------------------- backend (Flask)
FLASK_APP=wsgi.py

# Long random strings. Changing them signs everyone out.
SECRET_KEY=change-me-to-a-long-random-string
JWT_SECRET_KEY=change-me-too

# Leave empty to use the embedded PostgreSQL that run.py starts in .pgdata/.
# Set it for Docker or a real server, e.g. postgresql+psycopg://tym:tym@localhost:5432/tym
DATABASE_URL=

# Leave empty to keep rate limits in memory. Set when Redis runs, e.g. redis://localhost:6379/0
REDIS_URL=

# Comma separated list of allowed website origins
CORS_ORIGINS=http://localhost:5173

# DigitalOcean Spaces (S3 compatible): private bucket for ID checks and uploads.
# Empty key = files are kept in backend/instance/private on this machine.
SPACES_ENDPOINT=https://blr1.digitaloceanspaces.com
SPACES_REGION=blr1
SPACES_KEY=
SPACES_SECRET=
SPACES_BUCKET=tym-media

# Email (Resend). Empty = codes are not emailed; in development the sign-up page shows them.
RESEND_API_KEY=
MAIL_FROM=The Youth Matters <no-reply@theyouthmatters.org>
# Where the contact form and mentor applications are sent
CONTACT_EMAIL=hello@theyouthmatters.org

# Google sign-in: OAuth client ID from Google Cloud Console (same value in VITE_GOOGLE_CLIENT_ID below)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Razorpay (mentor session payments). Dashboard -> Settings -> API Keys. Test keys (rzp_test_...)
# work end to end with Razorpay's test cards and UPI, no real money.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard -> Webhooks: URL https://<your-domain>/api/payments/razorpay/webhook,
# events payment.captured and order.paid, then paste the secret you chose here.
RAZORPAY_WEBHOOK_SECRET=

# ---------------------------------------------------------------- website (Vite)
# Empty = the Google button explains that Google sign-in is not on yet.
VITE_GOOGLE_CLIENT_ID=
